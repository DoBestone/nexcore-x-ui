[Unit]
Description=NexCore x-ui panel
# network-online.target = "network is actually up with an IP", whereas
# network.target only means "network config has been processed". On
# many cloud images (cloud-init, NetworkManager-wait-online) the panel
# would otherwise race DHCP/DNS on first boot and flap until the
# Restart= policy eventually caught up.
After=network-online.target
Wants=network-online.target

# Crash-loop circuit breaker: if the unit fails to start more than
# StartLimitBurst times within StartLimitIntervalSec seconds, systemd
# stops re-spawning it. Without this, a misconfigured panel (bad DB,
# missing cert, port already bound) would be restarted forever, burning
# CPU and drowning the journal. With it, after 5 fails in 5 minutes the
# unit lands in "failed" state and waits for an operator. Recover with:
#   systemctl reset-failed nexcore-x-ui && systemctl start nexcore-x-ui
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=/usr/local/nexcore-x-ui/
ExecStart=/usr/local/nexcore-x-ui/nexcore-x-ui

# Restart policy
Restart=on-failure
RestartSec=5s

# Hardening: panel + xray run as root by upstream design (xray binds privileged
# ports and reads /root/cert paths). The flags below add defense-in-depth so a
# compromise of the panel binary or xray-core doesn't immediately translate to
# a full host takeover.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RemoveIPC=true
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
# Whitelist that systemd updates as new "safe" syscalls land. We keep this
# but DO NOT layer the negative filter on top — earlier versions had
# `SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation
# @obsolete @raw-io @reboot @swap` which sent SIGSYS to the process on
# the first blocked call. That bit Go 1.26's runtime hard:
#
#   - @resources blocks prlimit64 / setrlimit; Go uses prlimit64 at
#     startup to bump RLIMIT_NOFILE so it can serve more than 1024 fds
#   - on systemd < 252 @system-service didn't include clone3, and Go 1.20+
#     uses clone3 for goroutine creation; combined with the negative
#     filter the FIRST goroutine spawned in runWebServer killed the
#     process with SIGSYS
#
# CLI commands like `setting -show` (single goroutine, no rlimit bump)
# survived, which is why the bug only showed up when the panel was
# launched under systemd — confusing operators into thinking the install
# script was broken when actually the binary was being killed seconds
# after boot.
#
# SystemCallErrorNumber=EPERM is the belt-and-suspenders fix: any
# remaining blocked call will return -EPERM instead of SIGSYS-killing
# the process. Go's runtime tolerates EPERM from rlimit calls and from
# clone3 (it falls back to clone). Net effect: the panel keeps running,
# specific feature might gracefully fail, no crash loop.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/etc/nexcore-x-ui /usr/local/nexcore-x-ui /root/cert /var/log
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
