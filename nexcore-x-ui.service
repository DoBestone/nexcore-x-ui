[Unit]
Description=NexCore x-ui panel
After=network.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/usr/local/nexcore-x-ui/
ExecStart=/usr/local/nexcore-x-ui/nexcore-x-ui

# Restart policy
Restart=on-failure
RestartSec=5s

# Hardening: panel + xray run as root by upstream design (xray binds privileged
# ports and reads /root/cert paths). The flags below add defense-in-depth so a
# compromise of the panel binary or xray-core doesn't immediately translate to
# a full host takeover.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RemoveIPC=true
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap
ReadWritePaths=/etc/nexcore-x-ui /usr/local/nexcore-x-ui /root/cert /var/log
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
