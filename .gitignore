# build artifacts
/x-ui
/x-ui-*
/main
/release.sh
*.tar.gz
*.test
*.out
dist/

# Vite 插件自动生成的 d.ts —— 每次启动 dev / build 会刷新,不该进 git。
# unplugin-auto-import 写 auto-imports.d.ts;unplugin-vue-components 写
# components.d.ts。检入 git 会带来无意义的合并冲突,也会让历史里出现
# AI 给我们生成的"虚假改动"。CI 上每次 build 会自动重生。
web/frontend/auto-imports.d.ts
web/frontend/components.d.ts

# data / runtime
*.db
*.db-journal
install-info.txt
# bin/* is populated at runtime by the install script (downloads xray-core
# from XTLS) or by GitHub Actions during the release build. Do not check
# binaries / geo data into git.
bin/config.json
bin/xray-darwin-*
bin/xray-linux-*
bin/xray-windows-*
bin/geoip.dat
bin/geosite.dat
# xray runtime access / error logs (启动后 xray 自己写,不进 git)
bin/access.log
bin/error.log

# editor / OS
.idea/
.vscode/
.DS_Store
.sync*
tmp/
.claude/

# AI 协作上下文(本地决策档案,不公开)
CLAUDE.md
.cursorrules
.aider*
